# Copy to .env for local runs only. On Coolify, set these in the app's Environment screen instead.
# Every value below is a placeholder. Never commit a real .env.

TELEGRAM_BOT_TOKEN=paste-botfather-token-here
# Numeric Telegram user ID(s), comma separated. Only these people can use the bot.
ADMIN_IDS=123456789
# false = admins (and /allow-ed users) only. true = open to everyone.
ALLOW_ALL=false
BOT_NAME=Sathi
BOT_TZ_OFFSET_MINUTES=330
DAILY_USER_LIMIT=300

# Fallback order. A provider with no key is skipped.
PROVIDER_ORDER=gemini,groq,openrouter,cloudflare,ollama
PROVIDER_COOLDOWN_SECONDS=600

GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Set when you run the local-llm profile: http://ollama:11434
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b-instruct

TAVILY_API_KEY=
SERPER_API_KEY=

# --- extra features ---
# Optional: raises GitHub's rate limit for /github (public repos work without it)
GITHUB_TOKEN=
# Picture/file/link/GitHub uses per non-admin user per day
HEAVY_DAILY_LIMIT=15
# Admin-only /run. Leave false unless you understand the warning in the README.
ENABLE_ADMIN_SANDBOX=false
# Optional: a channel or group id that also gets the admin log lines (the bot must be an admin/member there)
LOG_CHAT_ID=

# --- E2B sandbox (admin /run, /sh, /files and agent mode). Free key at e2b.dev, no card needed ---
E2B_API_KEY=
# auto = use E2B when the key is set, else the weak local runner if ENABLE_ADMIN_SANDBOX=true. Or force: e2b | local
SANDBOX_BACKEND=auto
SANDBOX_TIMEOUT_SECONDS=60
SANDBOX_IDLE_SECONDS=300
SANDBOX_DAILY_LIMIT=200

# Hosted real browser for JavaScript / bot-walled pages (free key at browserless.io, 1000 units/month, no card). Optional.
BROWSERLESS_API_KEY=

# NVIDIA NIM free API (build.nvidia.com): GLM 5.3 Flash, ~40 requests/minute free. Optional; tried first when set.
NVIDIA_API_KEY=
NVIDIA_MODEL=z-ai/glm-5.3-flash
